__pycache__/
*.pyc
*.log

# secrets: HF_HOME lives here, and tokens must never be committed. Log in with
# `hf auth login` or export HF_TOKEN instead of writing a token into the tree.
hf/
*.token
.env

# runnable overlay: upstream verl-agent + patches/. Rebuild with
# scripts/sync_patches.sh; patches/ is the source of truth for our edits.
/verl-agent/

# environments and data, rebuilt by the benchmark setup scripts
/.venv/
/.venv-webshop/
/.venv-qwen/
/alfworld_data/
/envdata/
/jdk/
/.cache/
/wheels/
docker/wheels/

# per-run artefacts: config.json, NOTES.md, metrics.jsonl and plots/ are tracked;
# weights, raw logs and per-sample dumps are not
experiments/*/outputs/checkpoints/
experiments/*/outputs/train.log
experiments/*/outputs/train.pid
experiments/*/outputs/*.csv
experiments/*/outputs/**/*.csv

# Host-local migration records, controllers and reference checkouts.
/.local/
/searchr1/
/baselines
/legacy-experiments

# Generated launch scripts embed machine paths; regenerate from arm/config settings.
experiments/*/run.sh
experiments/*/outputs/**/*.pid
experiments/*/outputs/startup-*/

# Large per-sample research diagnostics stay local; aggregate metrics and plots
# remain versioned alongside experiment configs and method notes.
experiments/**/*.npz
experiments/**/*.prompts.jsonl.gz
experiments/**/*.tmp
experiments/**/outputs/future_progress/
experiments/**/outputs/fixed_anchor/
experiments/*/failure-analysis-*/**/episodes.jsonl
experiments/*/failure-analysis-*/**/launch.json
experiments/*/failure-analysis-*/**/exit.json
experiments/*/failure-analysis-*/run_pair.py
experiments/*/failure-analysis-*/behavior_diagnostics.json
experiments/*/failure-analysis-*/oracle_targets.json
experiments/*/failure-analysis-*/option_rescoring.json
experiments/*/failure-analysis-*/trace_analysis.json

# Prompt-only benchmark transcripts and resumable serving caches.
experiments/qwen38-*/episodes.jsonl
experiments/qwen38-*/turns.jsonl
experiments/qwen38-*/episodes/

# API pilot transcripts and request-level accounting; summaries stay versioned.
experiments/deepseek-*/outputs/

# Full-census local-model raw traces and token ledgers.
experiments/qwen38-*/outputs/
